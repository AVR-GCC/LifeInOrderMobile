{
  "expo": {
    "name": "Life In Order",
    "slug": "life-in-order",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "lifeinorder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifeinorder.app",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#213448"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.lifeinorder.app",
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#213448"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "52060ddc-dd60-43b5-8ba3-ed140b9ff3dd"
      }
    },
    "owner": "ogoun-apps",
    "updates": {
      "url": "https://u.expo.dev/52060ddc-dd60-43b5-8ba3-ed140b9ff3dd"
    }
  }
}
